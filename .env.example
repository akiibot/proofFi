# Bootstrap generates local credentials. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=sqlite:///./prooffi.db
# Legacy prototype API_TOKEN is no longer accepted for user authentication.
API_TOKEN=
DEMO_PASSWORD_HASH=
TRUSTED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
COOKIE_SECURE=false
DEPLOYMENT_MODE=local
API_BASE_URL=http://127.0.0.1:8000
DEMO_MODE=true
CHAIN_ID=84532
# Required later for actual testnet execution; all intentionally unset.
RPC_URL=
TEST_TOKEN_ADDRESS=
APPROVED_RECIPIENT=
WALLET_ADDRESS=
SIGNER_PRIVATE_KEY=
# Remains off until operator configuration and lead execution review are complete.
EXECUTION_ENABLED=false
# PF-029: lowercase 64-hex Ed25519 seed, never a transaction signing key.
VERIFIER_PRIVATE_KEY=
VERIFIER_KEY_ID=
# JSON object of key IDs to lowercase 32-byte public-key hex; retain historical keys.
VERIFIER_PUBLIC_KEYS_JSON=
# PF-029 server-only JSON; see docs/TRUSTED_ISSUANCE.md. No default transaction authority.
VERIFIER_TRANSACTION_CONFIG_JSON=
LLM_API_KEY=
# Vertex Express only: GEMINI_API_KEY is an alias for LLM_API_KEY. Set ONE;
# two different values fail closed. Never use NEXT_PUBLIC_ for either.
GEMINI_API_KEY=
# Explicit existing auth methods: vertex_express (key) or vertex_oauth (gcloud).
PLANNER_PROVIDER=vertex_express
PLANNER_MODE=live_llm
# Legacy planner model remains supported; explicit reasoning model takes precedence.
VERTEX_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_REASONING_FALLBACK_MODEL=
GEMINI_SUMMARY_MODEL=
GEMINI_TRANSLATION_MODEL=
GEMINI_QUERY_MODEL=
