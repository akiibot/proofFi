{
  "name": "vallet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*",
    "apps/extension"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "contracts": "node scripts/contracts.mjs",
    "check": "node scripts/check.mjs",
    "build:extension": "npm run build -w @prooffi/extension",
    "test:extension": "npm run test -w @prooffi/extension",
    "lint:extension": "npm run lint -w @prooffi/extension"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
